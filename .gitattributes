# 仓库内统一按 LF 存储，避免 Windows/macOS/Linux 之间行尾漂移。
# 若本机 core.autocrlf=true，本文件会覆盖它。
* text=auto eol=lf

# 文本文件显式声明
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf

# Windows 专用脚本保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制文件不做行尾转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.bmp   binary
*.tif   binary
*.tiff  binary
*.ico   binary
*.pdf   binary
*.ttf   binary
*.otf   binary
*.zip   binary
